#!/usr/bin/env bash
# Ralph configuration — tells ralph/ralph.sh which GitHub issues to work, and
# how. This file is *sourced* by ralph.sh. Set values only; don't add logic here.

# ── What to work ────────────────────────────────────────────────────────────
# Ordered list of GitHub issue numbers. Each entry is either a single issue
# (e.g. 50) or an inclusive range "A-B" (e.g. "51-53" → 51, 52, 53). The order
# in this array IS the priority; ranges expand in place. Ralph processes them
# top-to-bottom, one fresh claude session per issue. At least one entry required.
RALPH_ISSUES=(
  "91-94"
  95
  99
)

# ── How to work ─────────────────────────────────────────────────────────────
# Ralph runs the whole list in ONE git worktree, forked from RALPH_BASE_REF, and
# opens ONE draft PR back to RALPH_BASE_REF when done. The PR title/body are
# derived from the issues' own titles, so they read well on their own.
#
# Branch name: leave EMPTY to auto-generate a unique per-run branch
# "ralph/<timestamp>" — each run gets its own branch + PR, so batches never
# collide. Set a STABLE name instead ONLY to resume a dependent multi-issue
# batch after a fail-fast (a re-run then reuses that worktree and skips the
# issues already closed).
RALPH_BRANCH=""

# Base branch the run branch forks from, and the PR target.
RALPH_BASE_REF="dev"

# Only process an issue that carries this label; others are skipped with a
# warning. Set to "" to disable the gate and attempt every issue in the list.
RALPH_REQUIRE_LABEL="ready-for-agent"

# Open a draft PR against RALPH_BASE_REF when the list finishes (needs gh).
# Ralph never merges — the merge is always yours.
RALPH_OPEN_PR=1

# After each issue's implement session, run a SECOND isolated claude session
# (fresh context) that code-reviews the implementation commit against this
# repo's standards and against the issue, and posts its report as a comment on
# the issue. It changes no code, and it ends its report with a verdict line
# counting what is objectively fixable. Set to 0 to skip it.
RALPH_REVIEW=1

# When that verdict counts anything FIXABLE, run a THIRD isolated session that
# applies those findings — a missing or wrong requirement, a broken documented
# rule — and commits them. It never touches what the review marked advisory
# (smells, scope creep): those are yours to scope. Set to 0 to review without
# fixing. Needs RALPH_REVIEW=1; with no review there is nothing to apply.
RALPH_FIX=1

# ── How each headless claude session runs ───────────────────────────────────
# Model per step; each defaults to RALPH_MODEL, so they can differ when you want
# the reviewer or the fixer on something heavier than the implementer.
RALPH_MODEL="claude-sonnet-5"          # step 1: implement
RALPH_REVIEW_MODEL="claude-sonnet-5"   # step 2: code-review
RALPH_FIX_MODEL="claude-sonnet-5"      # step 3: apply the review
RALPH_PERMISSION_MODE="auto"

# Tools no session may use, space-separated. ScheduleWakeup is banned because
# waiting for a notification nobody delivers is how a headless session strands
# itself. Set to "" to lift the ban.
RALPH_DISALLOWED_TOOLS="ScheduleWakeup"

# ── What each session is told ───────────────────────────────────────────────
# The prompts live in ralph/prompts/*.md, versioned with the repo and reviewable
# in a PR — not in this file, and not in a skill. A skill is installed per user
# and moves with its plugin; a prompt in git is pinned to the commit that ran it,
# which is what makes a run reproducible. Inside a prompt, {{N}} is the issue
# number, {{BASE}} the commit the review diffs against, and {{INCLUDE:parts/x.md}}
# splices in a shared part.
#
# Uncomment only to point a step somewhere else; a relative path is read from the
# repo root.
# RALPH_PROMPT_FILE="ralph/prompts/1-implement.md"
# RALPH_REVIEW_PROMPT_FILE="ralph/prompts/2-review.md"
# RALPH_FIX_PROMPT_FILE="ralph/prompts/3-fix.md"

# Max issues to actually run per invocation (empty = unlimited). Skipped issues
# (already closed / missing label) do NOT count. --max-iterations overrides this.
RALPH_MAX_ITERATIONS=""
