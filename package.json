{
	"name": "poschuler.com",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.13.1",
	"scripts": {
		"ralph": "bash ralph/ralph.sh",
		"ralph:clean": "bash ralph/ralph-clean.sh",
		"build": "react-router build",
		"cf-typegen": "wrangler types",
		"deploy": "pnpm run build && wrangler deploy",
		"dev": "react-router dev",
		"postinstall": "pnpm run cf-typegen",
		"preview": "pnpm run build && vite preview",
		"smoke": "pnpm run build && bash ./scripts/smoke-test.sh",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"typecheck": "pnpm run cf-typegen && react-router typegen && tsc -b && tsc -p tsconfig.test.json",
		"kv:generate": "node ./seed/kv/generate-kv-json.ts",
		"kv:upload:local": "node ./seed/kv/kv-bulk-upload.ts local",
		"kv:upload:remote": "node ./seed/kv/kv-bulk-upload.ts remote",
		"kv:seed:local": "pnpm run kv:generate && pnpm run kv:upload:local",
		"kv:seed:remote": "pnpm run kv:generate && pnpm run kv:upload:remote",
		"d1:generate": "node ./seed/d1/generate-seed-sql.ts",
		"d1:upsert:local": "wrangler d1 execute poschuler --file ./seed/d1/seed.sql --local",
		"d1:upsert:remote": "wrangler d1 execute poschuler --file ./seed/d1/seed.sql --remote",
		"d1:seed:local": "pnpm run d1:generate && pnpm run d1:upsert:local",
		"d1:seed:remote": "pnpm run d1:generate && pnpm run d1:upsert:remote",
		"d1:reset:local": "node ./seed/reset-local-d1.ts",
		"d1:migrate:remote": "wrangler d1 migrations apply poschuler --remote",
		"verify:stores:local": "node ./seed/verify-stores.ts local",
		"verify:stores:remote": "node ./seed/verify-stores.ts remote",
		"verify:schema:local": "node ./seed/verify-schema.ts local",
		"verify:schema:remote": "node ./seed/verify-schema.ts remote",
		"check:fixtures": "bash ./scripts/check-generated-fixtures.sh",
		"preview:drafts": "bash ./scripts/preview-drafts.sh"
	},
	"dependencies": {
		"@base-ui/react": "^1.6.0",
		"@fontsource-variable/intel-one-mono": "^5.3.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@radix-ui/colors": "^3.0.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"front-matter": "^4.0.2",
		"isbot": "^5.2.1",
		"lucide-react": "^1.27.0",
		"marked": "^18.0.7",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-router": "^8.3.0",
		"remix-utils": "^10.0.0",
		"tailwind-merge": "^3.6.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.47.0",
		"@cloudflare/workers-types": "^5.20260727.1",
		"@react-router/dev": "^8.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^22",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitest/coverage-v8": "^4.1.10",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.9.3",
		"vite": "^8.1.5",
		"vitest": "^4.1.10",
		"wrangler": "^4.114.0"
	}
}
