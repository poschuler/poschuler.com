{
	"name": "poschuler.com",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.13.1",
	"scripts": {
		"build": "react-router build",
		"cf-typegen": "wrangler types",
		"deploy": "pnpm run build && wrangler deploy",
		"dev": "react-router dev",
		"postinstall": "pnpm run cf-typegen",
		"preview": "pnpm run build && vite preview",
		"typecheck": "pnpm run cf-typegen && react-router typegen && tsc -b",
		"kv:generate": "node ./seed/kv/generate-kv-json.ts",
		"kv:upload:local": "node ./seed/kv/kv-bulk-upload.ts local",
		"kv:upload:remote": "node ./seed/kv/kv-bulk-upload.ts remote",
		"kv:seed:local": "pnpm run kv:generate && pnpm run kv:upload:local",
		"kv:seed:remote": "pnpm run kv:generate && pnpm run kv:upload:remote",
		"d1:generate": "node ./seed/d1/generate-seed-sql.ts",
		"d1:upsert:local": "wrangler d1 execute poschuler --file ./seed/d1/seed.sql --local",
		"d1:upsert:remote": "wrangler d1 execute poschuler --file ./seed/d1/seed.sql --remote",
		"d1:seed:local": "pnpm run d1:generate && pnpm run d1:upsert:local",
		"d1:seed:remote": "pnpm run d1:generate && pnpm run d1:upsert:remote"
	},
	"dependencies": {
		"@base-ui/react": "^1.6.0",
		"@radix-ui/colors": "^3.0.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"front-matter": "^4.0.2",
		"isbot": "^5.2.1",
		"lucide-react": "^1.27.0",
		"marked": "^18.0.7",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-router": "^8.3.0",
		"remix-utils": "^10.0.0",
		"tailwind-merge": "^3.6.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.47.0",
		"@cloudflare/workers-types": "^5.20260727.1",
		"@react-router/dev": "^8.3.0",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^22",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.3",
		"vite": "^8.1.5",
		"wrangler": "^4.114.0"
	}
}
