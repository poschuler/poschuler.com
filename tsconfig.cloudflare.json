{
  "extends": "./tsconfig.json",
  "include": [
    ".react-router/types/**/*",
    "app/**/*",
    "app/**/.server/**/*",
    "app/**/.client/**/*",
    "workers/**/*",
    "worker-configuration.d.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "strict": true,
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "types": ["node", "vite/client"],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "baseUrl": ".",
    "rootDirs": [".", "./.react-router/types"],
    "paths": {
      "~/*": ["./app/*"]
    },
    "esModuleInterop": true,
    "resolveJsonModule": true,
    // `app/lib/hrefs.ts`, `app/lib/seo/alternates.ts` and `app/lib/seo/person.ts`
    // import each other with a relative `.ts` extension rather than `~/*`
    // (their own docblocks explain why: `seed/kv/sitemap-routes.ts` imports
    // `alternates.ts` directly, and Node resolves a plain script's specifiers
    // exactly as written, with no alias). `noEmit` is already true throughout
    // this file's chain, which is this flag's only prerequisite.
    "allowImportingTsExtensions": true
  }
}
